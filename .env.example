# ============================================================
# MLOps Pipeline — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---------- Azure Configuration ----------
# These are used by GitHub Actions for OIDC-based Azure login.
# Get these values from: az ad sp show --id <client-id> --query '[appId,tenantId]'
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# ---------- Azure Container Registry ----------
# Used for docker login during CI builds.
# Get these from: az acr show --name <acr-name> --query '[loginServer,username]'
AZURE_ACR=sarafanujayacr.azurecr.io
ACR_USERNAME=
ACR_PASSWORD=
ACR_LOGIN_SERVER=sarafanujayacr.azurecr.io

# ---------- Dashboard Environment ----------
# The dashboard uses these at runtime (Next.js PUBLIC vars).
NEXT_PUBLIC_GITHUB_REPO=Anujay-Saraf/Realtime-MLOPs

# For local development, point to the Docker Compose service name.
# For production (Azure deployment), this is set dynamically by the CI.
NEXT_PUBLIC_API_BASE_URL=http://order-api:8000

# ---------- Monitoring ----------
# Grafana admin password (default: admin)
GRAFANA_PASSWORD=admin

# ---------- API Model Configuration ----------
# Optional: override default model path. Useful for A/B testing or
# production deployments where the model lives on a mounted volume.
# MODEL_PATH=/models/order_prediction_model.joblib

# ---------- Data Directory ----------
# Optional: override training data directory.
# DATA_DIR=./data

# ---------- DVC Remote Storage ----------
# Azure Blob Storage connection string for DVC remote.
# Get this from: az storage account show-connection-string --name <storage-account>
# Store the real value in .env (which is gitignored), NOT in .env.example.
AZURE_STORAGE_CONNECTION_STRING=

# Azure Blob Storage account name (used for DVC remote auth via az login session)
AZURE_STORAGE_ACCOUNT=testml3410875630
