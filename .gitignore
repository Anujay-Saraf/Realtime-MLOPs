# ── DVC-tracked content (keep .dvc pointers, ignore actual files) ──────────
# DVC pointer files (*.dvc) are tracked by git — commit them.
# The actual data/models stay in the DVC cache / remote.

# Data directory: ignore the actual CSV, allow .dvc pointer
data/
!data/*.dvc

# Models: ignore the actual .joblib files, allow .dvc pointers
models/*.joblib
models/*.pkl
!models/*.dvc

# User-uploaded datasets that override the default
data/uploads/
test-system.ps1
test_*.json
.run-logs/
